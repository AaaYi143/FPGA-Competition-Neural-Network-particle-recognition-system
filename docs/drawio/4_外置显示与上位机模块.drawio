        <mxCell id="e4_stm_2" value="有效非空微粒结果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#1E40AF;fontSize=11;labelBackgroundColor=#FFFFFF;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;;entryX=0;entryY=0.24;entryDx=0;entryDy=0;" edge="1" parent="1" source="h4_stm_rx" target="h4_stm_vote">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4_stm_3" value="清空队列复位指令" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;dashed=1;fontColor=#92400E;fontSize=11;labelBackgroundColor=#FFFFFF;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;;entryX=0;entryY=0.78;entryDx=0;entryDy=0;" edge="1" parent="1" source="h4_stm_guard" target="h4_stm_vote">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4_stm_4" value="稳态类别 &amp; 四类得票率" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#1E40AF;fontSize=11;labelBackgroundColor=#FFFFFF;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h4_stm_vote" target="h4_stm_lcd">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4_u_pc0" value="SW6=0: 66B 能谱帧 (8E1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#5B21B6;fontSize=11;labelBackgroundColor=#FFFFFF;;exitX=1;exitY=0.35;exitDx=0;exitDy=0;;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h4_uart_pc" target="h4_labview">
