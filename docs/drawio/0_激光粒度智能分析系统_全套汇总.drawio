        </mxCell>
        <mxCell id="e4_u_pc1" value="SW6=1: 8B 结果帧 (8E1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#7C3AED;strokeWidth=2;fontColor=#5B21B6;fontSize=11;labelBackgroundColor=#FFFFFF;;exitX=1;exitY=0.83;exitDx=0;exitDy=0;;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h4_uart_pc" target="h4_py_decoder">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="425" y="625" />
              <mxPoint x="425" y="737" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e4_sample" value="导出 data_txt/*.txt 样本" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#1E40AF;fontSize=11;labelBackgroundColor=#FFFFFF;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="h4_labview" target="h4_pytorch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4_vh" value="生成 weights.vh &amp; scales.vh 固化回 FPGA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;dashed=1;fontColor=#92400E;fontSize=11;labelBackgroundColor=#FFFFFF;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="h4_pytorch" target="h4_fpga_core">
          <mxGeometry relative="1" as="geometry">
