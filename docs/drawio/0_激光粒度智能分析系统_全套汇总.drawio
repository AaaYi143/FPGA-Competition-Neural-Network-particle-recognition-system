        <mxCell id="e4_u_pc_pga" value="下发 PGA 增益指令 (0~F)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=2;dashed=1;fontColor=#92400E;fontSize=11;labelBackgroundColor=#FFFFFF;;exitX=0;exitY=0.75;exitDx=0;exitDy=0;;entryX=1;entryY=0.65;entryDx=0;entryDy=0;" edge="1" parent="1" source="h4_labview" target="h4_uart_pc">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="415" y="630" />
              <mxPoint x="415" y="595" />
            </Array>
