        <mxCell id="header_title" value="基于 FPGA 片上神经网络加速的实时激光粒度智能分析系统 — 系统总体架构框图" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#1E3A8A;strokeColor=#1D4ED8;strokeWidth=2;fontColor=#FFFFFF;fontStyle=1;fontSize=18;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="15" width="1520" height="48" as="geometry" />
        </mxCell>
        <mxCell id="c1_optics" value="① 激光衍射光学与光电传感模块" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#EBF5FF;strokeColor=#2563EB;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=15;spacingTop=10;fontColor=#1E3A8A;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="410" height="350" as="geometry" />
